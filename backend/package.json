{
  "name": "phonemail-api",
  "version": "1.0.0",
  "private": true,
  "description": "PhoneMail core API: accounts, OTP auth, mail delivery, conversations, Twilio IVR/SMS webhooks.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.4.0",
    "html-to-text": "^9.0.5",
    "libphonenumber-js": "^1.12.10",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.16.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "form-data": "^4.0.6",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
