# Copy to .env and adjust. Everything is optional: the defaults run a fully local demo where
# SMS (OTPs and notifications) show up in the dev outbox at http://localhost:8088/api/dev/sms/view

# --- Core ---
MAIL_DOMAIN=phonemail.com
DEFAULT_COUNTRY=IN                     # numbers typed without a country code are treated as this country
APP_SECRET=change-me-to-a-long-random-string
INTERNAL_API_TOKEN=change-me-internal-token
POSTGRES_PASSWORD=phonemail
PUBLIC_WEB_URL=http://localhost:8088   # used in SMS texts ("sign in at ...")
PUBLIC_PORTAL_URL=http://localhost:8089
COOKIE_SECURE=false                    # set true when serving the web client over HTTPS

# --- Ports ---
WEB_PORT=8088
PORTAL_PORT=8089
SMTP_PORT=2525
MAILPIT_PORT=8025

# --- SMS & OTP ---
# SMS_PROVIDER: console | twilio | twilio_verify | smsgate | textbelt | fast2sms
#   console        nothing is sent; messages appear in the dev SMS outbox (default)
#   twilio         Twilio Programmable SMS with custom text (trial: verified numbers only)
#   twilio_verify  Twilio Verify's pre-approved template as the "new email" ping (works where
#                  custom text is blocked on trial accounts, e.g. India). Requires OTP_PROVIDER=twilio_verify.
#   smsgate        FREE custom SMS through your own Android phone (https://sms-gate.app)
#   textbelt       https://textbelt.com (key "textbelt" = 1 free SMS/day)
#   fast2sms       low-cost Indian gateway (https://www.fast2sms.com)
SMS_PROVIDER=console
# OTP_PROVIDER: local (we generate the code and send it via SMS_PROVIDER) | twilio_verify
OTP_PROVIDER=local
DEV_SMS_OUTBOX=true                    # only ever active with SMS_PROVIDER=console
SMS_NOTIFY_MAX_PER_HOUR=10

# --- Twilio (free trial) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                    # your Twilio number in E.164, e.g. +18885551234
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=             # VAxxxxxxxx, for OTP_PROVIDER/SMS_PROVIDER=twilio_verify
TWILIO_WEBHOOK_BASE_URL=               # public URL Twilio calls, e.g. https://abcd.ngrok-free.app
TWILIO_VALIDATE_WEBHOOKS=true
IVR_VOICE=Polly.Aditi
IVR_LANGUAGE=en-IN

# --- SMSGate (Android phone as SMS gateway) ---
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# --- Other gateways ---
TEXTBELT_KEY=textbelt
FAST2SMS_API_KEY=

# --- Outbound mail to other providers (gmail.com etc.) ---
# Default: caught by Mailpit (http://localhost:8025). Leave empty to disable external mail.
SMTP_RELAY_URL=smtp://mailpit:1025
